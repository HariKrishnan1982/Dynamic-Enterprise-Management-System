# ConAI Backend — Environment Variables
# Copy this file to .env and edit values before running.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./conai.db

# PostgreSQL (swap in when available):
# DATABASE_URL=postgresql://conai:password@localhost:5432/conai

# ─── JWT ──────────────────────────────────────────────────────────────────────
# MUST be changed in production — use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret

# Token lifetime in minutes (default 60)
TOKEN_EXPIRE_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ─── Storage ──────────────────────────────────────────────────────────────────
# Directory for uploaded files (relative to backend/ or absolute path)
UPLOADS_DIR=uploads

# ─── Ingestion ────────────────────────────────────────────────────────────────
# Max characters per knowledge chunk
INGEST_CHUNK_SIZE=1500
# Overlap between consecutive chunks
INGEST_CHUNK_OVERLAP=200
